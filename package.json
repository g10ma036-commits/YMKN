{
  "name": "ymkn",
  "version": "1.0.0",
  "description": "Claude Code Windows git-bash configuration utility",
  "main": "out/main/main.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "doe:dev": "electron-vite dev",
    "doe:build": "electron-vite build",
    "start": "npm run doe:build && electron .",
    "dist": "npm run doe:build && electron-builder"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-plotly.js": "^2.6.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "jstat": "^1.9.6",
    "ml-matrix": "^6.11.0",
    "plotly.js-dist-min": "^2.35.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-plotly.js": "^2.6.0",
    "uuid": "^10.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/utils/**/*.test.ts"
    ]
  },
  "build": {
    "appId": "com.doe-analyst.app",
    "productName": "DOE アナリスト",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguage": "3041"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
